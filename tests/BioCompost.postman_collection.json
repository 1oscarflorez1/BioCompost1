{
  "info": {
    "name": "BioCompost API",
    "description": "Pruebas funcionales de la API REST de BioCompost.\n\n1. Inicie la API (uvicorn main:app --reload).\n2. Ejecute primero la carpeta '1. Autenticación' (guarda los tokens).\n3. Use 'Run collection' para ejecutar todo en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha de hoy (AAAA-MM-DD) disponible como {{hoy}}",
          "pm.collectionVariables.set('hoy', new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenRecolector",
      "value": ""
    },
    {
      "key": "idProveedor",
      "value": ""
    },
    {
      "key": "idRecoleccion",
      "value": ""
    },
    {
      "key": "hoy",
      "value": ""
    },
    {
      "key": "idRolRecolector",
      "value": ""
    },
    {
      "key": "nombreRolOriginal",
      "value": ""
    },
    {
      "key": "descripcionRolOriginal",
      "value": ""
    }
  ],
