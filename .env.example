# =====================================================================
# Plantilla de variables de entorno de BioCompost.
# Copie este archivo como ".env" (en la misma carpeta) y ajuste los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# =====================================================================

# --- Conexión a Oracle (la usa el backend con oracledb) ---
DB_USER=biocompost
DB_PASSWORD=cambie_esta_clave
# Formato host:puerto/servicio. Docker local: localhost:1521/FREEPDB1
# Oracle XE 21c instalado en Windows: localhost:1521/XEPDB1
DB_DSN=localhost:1521/FREEPDB1

# --- Solo para docker-compose: contraseña de SYS/SYSTEM del contenedor ---
ORACLE_ADMIN_PASSWORD=cambie_esta_clave_admin

# --- Seguridad JWT ---
# Genere una clave larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambie_esta_clave_secreta
JWT_EXPIRE_MINUTES=480

# --- Orígenes permitidos (CORS) para el frontend, separados por coma ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
